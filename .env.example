# 项目配置
PROJECT_NAME="Edu Multi-Agent Service"
DEBUG=True


OPENAI_API_KEY="your-llm-api-key-here"
OPENAI_API_BASE="https://api.openai.com/v1"  # 如果用国内模型请修改这里的 Base URL
LLM_MODEL_NAME="gpt-4-turbo"                 # 建议用聪明一点的模型作为大脑

# 底层 RAG API 配置 (指向你图片中的那个服务)
RAG_API_BASE_URL="http://localhost:8000"     # 修改为你的 edu-rag-bot 实际运行地址


# 阿里云 PostgreSQL 配置 (格式: postgresql://用户名:密码@外网地址:端口/数据库名)
POSTGRES_URL="postgresql://root:your_password@rm-xxxxx.pg.rds.aliyuncs.com:3432/edu_db"

# 阿里云 Redis 配置 (格式: redis://:密码@外网地址:端口/库号)
REDIS_URL="redis://:your_password@r-xxxxx.redis.rds.aliyuncs.com:6379/0"

# 阿里云 DashVector 向量库配置 (先写在这，留着稍后用)
DASHVECTOR_API_KEY="your_dashvector_api_key"
DASHVECTOR_ENDPOINT="your_dashvector_endpoint"
